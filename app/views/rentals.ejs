<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="UTF-8">
    <title>บันทึกการเช่า-คืน - ระบบเช่าหนังสือ</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</head>
<body class="container py-4">
    <nav class="nav nav-pills nav-fill mb-4 p-2 bg-light border rounded">
        <a class="nav-link active" href="/rentals">📋 บันทึกการเช่า-คืน</a>
        <a class="nav-link" href="/books">📚 จัดการรายการหนังสือ</a>
        <a class="nav-link" href="/customers">👤 จัดการรายชื่อผู้เช่า</a>
    </nav>

    <!-- Form บันทึกการเช่า -->
    <div class="card mb-4 p-3 bg-light shadow-sm border-primary">
        <h3 class="text-primary">บันทึกทำรายการเช่าหนังสือ6703952</h3>
        <form action="/rentals/add" method="POST" class="row g-3 mt-1">
            <div class="col-md-3">
                <label class="form-label">ผู้เช่าหนังสือ</label>
                <select name="customer_id" class="form-select" required>
                    <option value="">-- เลือกผู้เช่า --</option>
                    <% customers.forEach(c => { %>
                        <option value="<%= c.id %>"><%= c.customer_name %> (<%= c.phone_number %>)</option>
                    <% }) %>
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label">หนังสือที่ต้องการเช่า</label>
                <select name="book_id" class="form-select" required>
                    <option value="">-- เลือกหนังสือ --</option>
                    <% books.forEach(b => { %>
                        <option value="<%= b.id %>" <%= b.status === 'Rented' ? 'disabled' : '' %>>
                            <%= b.book_name %> <%= b.status === 'Rented' ? '(ถูกเช่าอยู่)' : '' %>
                        </option>
                    <% }) %>
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label">วันที่เริ่มเช่า (เลือกปฏิทิน)</label>
                <input type="date" name="rental_date" class="form-control" required>
            </div>
            <div class="col-md-3">
                <label class="form-label">กำหนดวันส่งคืน (เลือกปฏิทิน)</label>
                <input type="date" name="return_date" class="form-control" required>
            </div>
            <div class="col-12">
                <button type="submit" class="btn btn-primary fw-bold">บันทึกรายการเช่า</button>
            </div>
        </form>
    </div>

    <h3>รายการเช่า-คืนหนังสือทั้งหมด</h3>
    <table class="table table-striped table-bordered align-middle">
        <thead class="table-dark">
            <tr>
                <th>ID</th><th>ผู้เช่า</th><th>เบอร์โทร</th><th>หนังสือ</th><th>วันที่เช่า</th><th>กำหนดคืน</th><th>สถานะ</th><th>จัดการ</th>
            </tr>
        </thead>
        <tbody>
            <% rentals.forEach(item => { %>
                <tr>
                    <td><%= item.id %></td>
                    <td class="fw-bold"><%= item.customer_name %></td>
                    <td><%= item.phone_number %></td>
                    <td><%= item.book_name %></td>
                    <td><%= item.rental_date_formatted %></td>
                    <td><%= item.return_date_formatted %></td>
                    <td>
                        <span class="badge <%= item.status === 'Rented' ? 'bg-warning text-dark' : 'bg-success' %>">
                            <%= item.status === 'Rented' ? 'กำลังเช่าอยู่' : 'คืนเรียบร้อยแล้ว' %>
                        </span>
                    </td>
                    <td>
                        <button class="btn btn-warning btn-sm me-1" data-bs-toggle="modal" data-bs-target="#editRentalModal<%= item.id %>">แก้ไข / คืนหนังสือ</button>
                        <a href="/rentals/delete/<%= item.id %>" class="btn btn-danger btn-sm" onclick="return confirm('ยืนยันการลบรายการนี้?')">ลบ</a>
                    </td>
                </tr>

                <!-- Modal แก้ไขรายการเช่า -->
                <div class="modal fade" id="editRentalModal<%= item.id %>" tabindex="-1">
                    <div class="modal-dialog">
                        <div class="modal-content">
                            <form action="/rentals/update/<%= item.id %>" method="POST">
                                <div class="modal-header"><h5 class="modal-title">แก้ไขรายการเช่า (ID: <%= item.id %>)</h5></div>
                                <div class="modal-body row g-3">
                                    <div class="col-12">
                                        <label>ผู้เช่า</label>
                                        <select name="customer_id" class="form-select" required>
                                            <% customers.forEach(c => { %>
                                                <option value="<%= c.id %>" <%= c.id === item.customer_id ? 'selected' : '' %>><%= c.customer_name %></option>
                                            <% }) %>
                                        </select>
                                    </div>
                                    <div class="col-12">
                                        <label>หนังสือ</label>
                                        <select name="book_id" class="form-select" required>
                                            <% books.forEach(b => { %>
                                                <option value="<%= b.id %>" <%= b.id === item.book_id ? 'selected' : '' %>><%= b.book_name %></option>
                                            <% }) %>
                                        </select>
                                    </div>
                                    <div class="col-md-6">
                                        <label>วันที่เริ่มเช่า</label>
                                        <input type="date" name="rental_date" class="form-control" value="<%= item.rental_date_formatted %>" required>
                                    </div>
                                    <div class="col-md-6">
                                        <label>กำหนดวันส่งคืน</label>
                                        <input type="date" name="return_date" class="form-control" value="<%= item.return_date_formatted %>" required>
                                    </div>
                                    <div class="col-12">
                                        <label>สถานะการเช่า</label>
                                        <select name="status" class="form-select fw-bold">
                                            <option value="Rented" <%= item.status === 'Rented' ? 'selected' : '' %>>กำลังเช่าอยู่</option>
                                            <option value="Returned" <%= item.status === 'Returned' ? 'selected' : '' %>>คืนเรียบร้อยแล้ว</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="modal-footer">
                                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">ยกเลิก</button>
                                    <button type="submit" class="btn btn-primary">บันทึกการแก้ไข</button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            <% }) %>
        </tbody>
    </table>
</body>
</html>
