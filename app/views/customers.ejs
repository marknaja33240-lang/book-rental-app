<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="UTF-8">
    <title>จัดการผู้เช่า - ระบบเช่าหนังสือ</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</head>
<body class="container py-4">
    <nav class="nav nav-pills nav-fill mb-4 p-2 bg-light border rounded">
        <a class="nav-link" href="/rentals">📋 บันทึกการเช่า-คืน</a>
        <a class="nav-link" href="/books">📚 จัดการรายการหนังสือ</a>
        <a class="nav-link active" href="/customers">👤 จัดการรายชื่อผู้เช่า</a>
    </nav>

    <div class="card mb-4 p-3 bg-light shadow-sm">
        <h3>เพิ่มรายชื่อผู้เช่าใหม่</h3>
        <form action="/customers/add" method="POST" class="row g-3 mt-1">
            <div class="col-md-6">
                <label class="form-label">ชื่อ - นามสกุล ผู้เช่า</label>
                <input type="text" name="customer_name" class="form-control" required placeholder="เช่น นายสมชาย ใจดี">
            </div>
            <div class="col-md-6">
                <label class="form-label">เบอร์โทรศัพท์</label>
                <input type="text" name="phone_number" class="form-control" required placeholder="เช่น 081-234-5678">
            </div>
            <div class="col-12">
                <button type="submit" class="btn btn-success fw-bold">บันทึกผู้เช่า</button>
            </div>
        </form>
    </div>

    <h3>รายชื่อผู้เช่าทั้งหมด</h3>
    <table class="table table-striped table-bordered align-middle">
        <thead class="table-dark">
            <tr><th>ID</th><th>ชื่อ - นามสกุล</th><th>เบอร์โทรศัพท์</th><th>จัดการ</th></tr>
        </thead>
        <tbody>
            <% customers.forEach(item => { %>
                <tr>
                    <td><%= item.id %></td>
                    <td class="fw-bold"><%= item.customer_name %></td>
                    <td><%= item.phone_number %></td>
                    <td>
                        <button class="btn btn-warning btn-sm" data-bs-toggle="modal" data-bs-target="#editCustomerModal<%= item.id %>">แก้ไข</button>
                        <a href="/customers/delete/<%= item.id %>" class="btn btn-danger btn-sm" onclick="return confirm('ยืนยันการลบผู้เช่า?')">ลบ</a>
                    </td>
                </tr>

                <div class="modal fade" id="editCustomerModal<%= item.id %>" tabindex="-1">
                    <div class="modal-dialog">
                        <div class="modal-content">
                            <form action="/customers/update/<%= item.id %>" method="POST">
                                <div class="modal-header"><h5 class="modal-title">แก้ไขข้อมูลผู้เช่า</h5></div>
                                <div class="modal-body row g-3">
                                    <div class="col-12"><label>ชื่อ - นามสกุล</label><input type="text" name="customer_name" class="form-control" value="<%= item.customer_name %>" required></div>
                                    <div class="col-12"><label>เบอร์โทรศัพท์</label><input type="text" name="phone_number" class="form-control" value="<%= item.phone_number %>" required></div>
                                </div>
                                <div class="modal-footer"><button type="submit" class="btn btn-primary">บันทึกแก้ไข</button></div>
                            </form>
                        </div>
                    </div>
                </div>
            <% }) %>
        </tbody>
    </table>
</body>
</html>
